{
    "name": "spiggle/list-view",
    "description": "Filament v5 plugin that toggles tables between table and alphabetical list views.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/skillbobby/Spiggle-List-View",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "table",
        "list",
        "spiggle"
    ],
    "authors": [
        {
            "name": "Spiggle",
            "homepage": "https://github.com/skillbobby"
        }
    ],
    "support": {
        "issues": "https://github.com/skillbobby/Spiggle-List-View/issues",
        "source": "https://github.com/skillbobby/Spiggle-List-View"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0 || ^5.7",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Spiggle\\ListView\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiggle\\ListView\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spiggle\\ListView\\ListViewServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
